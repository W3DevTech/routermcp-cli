{
  "mcpServers": {
    "context7": {
      "transport": "http-streamable",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    },
    "xcodebuildmcp": {
      "transport": "stdio",
      "enabled": true,
      "command": "bunx",
      "args": [
        "-y",
        "xcodebuildmcp@latest"
      ],
      "allowedTools": [
        "install_app_device",
        "discover_projs",
        "build_device",
        "list_devices",
        "scaffold_ios_project"
      ]
    }
  }
}
{
  "name": "routermcp",
  "mcpName": "RouterMCP",
  "version": "0.1.9",
  "description": "A Bun-based CLI MCP Gateway that aggregates multiple upstream MCP servers",
  "type": "module",
  "main": "./dist/index.js",
  "npmReadme": "README.md",
  "bin": {
    "routermcp": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --packages=bundle --conditions module --minify",
    "prepublishOnly": "bun run build",
    "start": "bun run src/index.ts",
    "pack": "npm pack",
    "publish": "npm publish",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:coverage": "vitest run --coverage",
    "debug:opencode": "OPENCODE_CONFIG_DIR=./debug/opencode opencode"
  },
  "keywords": ["mcp", "model-context-protocol", "gateway", "cli", "router", "aggregator"],
  "author": "Ashutosh Kumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aistackhq/routermcp"
  },
  "homepage": "https://ashutoshanand.com",
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@clack/prompts": "^0.11.0",
    "@hono/node-server": "^1.19.7",
    "@jitl/quickjs-ng-wasmfile-release-sync": "^0.31.0",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@sebastianwessel/quickjs": "^3.0.0",
    "hono": "^4.11.3",
    "jsonc-parser": "^3.3.1",
    "micromatch": "^4.0.8",
    "smol-toml": "^1.3.4",
    "openapi-types": "^12.1.3",
    "yaml": "^2.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-everything": "latest",
    "@types/bun": "latest",
    "@types/micromatch": "^4.0.9",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}

{
  "name": "routermcp",
  "mcpName": "RouterMCP",
  "version": "0.1.9",
  "description": "A Bun-based CLI MCP Gateway that aggregates multiple upstream MCP servers",
  "type": "module",
  "main": "./dist/index.js",
  "npmReadme": "README.md",
  "bin": {
    "routermcp": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --packages=bundle --conditions module --minify",
    "prepublishOnly": "bun run build",
    "start": "bun run src/index.ts",
    "pack": "npm pack",
    "publish": "npm publish",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "cli",
    "router",
    "aggregator"
  ],
  "author": "Ashutosh Kumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aistackhq/routermcp"
  },
  "homepage": "https://ashutoshanand.com",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "hono": "^4.11.3",
    "jsonc-parser": "^3.3.1",
    "micromatch": "^4.0.8",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/micromatch": "^4.0.9",
    "typescript": "^5.7.0"
  }
}

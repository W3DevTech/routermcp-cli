{
  "name": "routermcp-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP Gateway CLI - Proxy/aggregate multiple MCP servers into one",
  "bin": {
    "routermcp": "./bin/routermcp"
  },
  "main": "./src/cli.ts",
  "scripts": {
    "start": "bun run src/cli.ts",
    "dev": "bun --watch src/cli.ts",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^13.1.0",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "gateway",
    "proxy"
  ],
  "license": "MIT"
}

{
  "name": "routermcp-cli",
  "version": "0.1.0",
  "description": "A Bun-based CLI MCP Gateway that aggregates multiple upstream MCP servers into a single unified interface",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "routermcp": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target bun"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@clack/prompts": "^0.11.0",
    "zod": "^3.25.0",
    "micromatch": "^4.0.8",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/micromatch": "^4.0.9",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}

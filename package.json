{
  "name": "routermcp",
  "mcpName": "RouterMCP",
  "version": "0.2.1",
  "description": "A Bun-based CLI MCP Gateway that aggregates multiple upstream MCP servers",
  "type": "module",
  "main": "./dist/index.js",
  "npmReadme": "README.md",
  "bin": {
    "routermcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "link": "bun install --global file:$(pwd)",
    "link:opencode": "bun run build && bun link && cd ~/.config/opencode && bun link routermcp && cd - > /dev/null",
    "build": "bun run scripts/write-version.ts && bun build src/index.ts --outdir dist --target bun --format esm --packages=bundle --conditions module --minify",
    "prepublishOnly": "bun run build",
    "start": "bun run src/index.ts",
    "pack": "npm pack",
    "publish": "npm publish",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:coverage": "vitest run --coverage",
    "search:sync": "node scripts/sync-search-contract.mjs",
    "search:verify": "node scripts/verify-search-contract.mjs",
    "debug:opencode": "OPENCODE_CONFIG_DIR=./debug/opencode opencode"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "cli",
    "router",
    "aggregator"
  ],
  "author": {
    "name": "Ashutosh Kumar",
    "url": "https://ashutoshanand.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/W3DevTech/routermcp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/W3DevTech/routermcp-cli/issues"
  },
  "homepage": "https://github.com/W3DevTech/routermcp-cli#readme",
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@clack/prompts": "^0.11.0",
    "@hono/node-server": "^1.19.7",
    "@jitl/quickjs-ng-wasmfile-release-sync": "^0.31.0",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@sebastianwessel/quickjs": "^3.0.0",
    "hono": "^4.11.3",
    "jsonc-parser": "^3.3.1",
    "micromatch": "^4.0.8",
    "smol-toml": "^1.3.4",
    "openapi-types": "^12.1.3",
    "yaml": "^2.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-everything": "latest",
    "@types/bun": "latest",
    "@types/micromatch": "^4.0.9",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
